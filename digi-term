#!/usr/bin/env python3
"""
DigiSmartDeck Smart Terminal Supervisor (digi-term)

Menjalankan shell/perintah di dalam pseudoterminal (PTY) dan memantau output-nya.
Ketika program di dalam terminal berhenti menunggu jawaban (Y/n, Allow/Deny,
menu bernomor, "Press Enter"), pertanyaan tersebut dikirim ke HP DigiSmartDeck
sebagai kartu pilihan. Jawaban dari HP disuntikkan langsung ke stdin terminal ini
saja -- tidak ada tombol yang dikirim ke jendela lain.

Platform: Linux dan macOS (POSIX PTY). Windows (ConPTY) belum didukung.

Pemakaian:
  digi-term                 # buka shell default di bawah pengawasan
  digi-term npm install     # jalankan satu perintah di bawah pengawasan
"""

import os
import sys

if os.name != 'posix':
    sys.stderr.write("digi-term saat ini hanya mendukung Linux dan macOS.\n")
    sys.exit(1)

import pty
import tty
import select
import termios
import struct
import fcntl
import signal
import json
import re
import time
import threading
import urllib.request

SERVER_PORT = int(os.environ.get('DIGI_PORT', '8080'))
PROMPT_URL = f"http://127.0.0.1:{SERVER_PORT}/api/prompt?wait=true"
DISMISS_URL = f"http://127.0.0.1:{SERVER_PORT}/api/prompt/dismiss"

ANSI_RE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1B\\))')
IDLE_SECONDS = 0.22          # output harus diam selama ini sebelum dianggap menunggu input
PROMPT_TIMEOUT = 120         # detik kartu tetap tampil di HP


def strip_ansi(text):
    return ANSI_RE.sub('', text).replace('\r', '')


def _opt(label, value, send, key=None, primary=False, danger=False):
    o = {'label': label, 'value': value, 'send': send}
    if key:
        o['key'] = key
    if primary:
        o['primary'] = True
    if danger:
        o['danger'] = True
    return o


def clean_terminal_text(buffer_text):
    clean = ANSI_RE.sub('', buffer_text)
    raw_lines = clean.split('\n')
    lines = []
    for l in raw_lines:
        parts = l.split('\r')
        effective = parts[-1].rstrip()
        if effective:
            lines.append(effective)
    return lines


AI_PERMISSION_KW = re.compile(
    r'(?i)\b('
    r'requesting\s+permission\s+for|'
    r'ask(?:ing)? for permission|'
    r'run(?:ning)? (?:this|the following)?\s*command|'
    r'execute(?:ing)? (?:this|the following)?\s*command|'
    r'allow (?:tool|action|command|execution|access)|'
    r'approve (?:tool|action|command|execution)|'
    r'do you want to (?:run|execute|proceed|continue|install|apply|delete|remove|overwrite)|'
    r'would you like to (?:run|execute|proceed|continue|install|apply)|'
    r'are you sure you want to|apakah anda yakin|'
    r'confirm execution|action required|approval required|'
    r'tool confirmation|surfacing tool confirmation|'
    r'allow tool call|deny tool call|allow calling this tool|'
    r'allow access to|proposed command|allow execution'
    r')\b'
)


def extract_prompt_details(lines, context, inspect_line):
    # 1. Prioritaskan ekstraksi info dari 'Requesting permission for:' jika ada
    message = ""
    req_match = re.search(
        r'(?i)requesting\s+permission\s+for\s*:\s*(.*?)(?=\n\s*(?:❯|[\[\(]?\d[\]\).:]|run this command\?|allow tool call\?|do you want|\Z))',
        context,
        re.DOTALL
    )
    if req_match:
        raw_info = req_match.group(1).strip()
        info_lines = []
        for l in raw_info.split('\n'):
            s = l.strip()
            if not s:
                continue
            s_low = s.lower()
            if s_low in ('run command', 'run comment', 'tool confirmation', 'proposed command:', 'proposed command'):
                continue
            if not info_lines or info_lines[-1].lower() != s.lower():
                info_lines.append(s)
        if info_lines:
            message = '\n'.join(info_lines)

    # 2. Jika tidak ada 'Requesting permission for:', cari CommandLine atau run_command
    if not message:
        cmd = ''
        cmd_match = re.search(r'(?i)(?:commandline|command|perintah)\s*:\s*["\'`]?\s*(.*?)(?:["\'`]?\s*$|\n)', context, re.MULTILINE)
        if cmd_match:
            cmd = cmd_match.group(1).strip()
        else:
            m2 = re.search(r'(?i)run_command\s*\(\s*["\'`]?([^\)"\'`]+)', context)
            if m2:
                cmd = m2.group(1).strip()
        if cmd:
            message = f"Perintah:\n> {cmd}"

    # 3. Fallback jika masih kosong
    if not message:
        clean_lines = []
        seen = set()
        for l in lines[-12:]:
            s = l.strip()
            if not s or re.match(r'^[❯>#\$%:\?]\s*$', s):
                continue
            if re.match(r'^\s*[❯>]?\s*(?:[\[\(]?\d{1,2}[\]\).:]|[\[\(][ xX●•*]?[\]\)])\s+\w+', s):
                continue
            s_low = s.lower()
            if s_low in ('run command', 'run comment', 'tool confirmation', 'proposed command:', 'proposed command'):
                continue
            if s_low not in seen:
                seen.add(s_low)
                clean_lines.append(s)
        message = '\n'.join(clean_lines) if clean_lines else inspect_line

    # 4. Tentukan title / pertanyaan
    c_lower = context.lower()
    if 'run this command' in c_lower or 'run' in c_lower or 'command' in c_lower or 'requesting permission' in c_lower:
        title = "Run this command?"
    elif 'tool call' in c_lower or 'tool' in c_lower:
        title = "Allow Tool Call?"
    elif 'permission' in c_lower or 'izin' in c_lower:
        title = "Ask for Permission"
    elif 'proceed' in c_lower or 'continue' in c_lower:
        title = "Do You Want to Proceed?"
    elif 'delete' in c_lower or 'remove' in c_lower:
        title = "Confirm Deletion?"
    else:
        title = "Run this command?"

    return title, message


def is_shell_prompt(s):
    s = s.strip()
    if not s:
        return False
    if re.search(r'^(?:\([^)]+\)\s*)?[\w\.\-]+@[\w\.\-]+[:\s].*[\$#%>]\s*$', s):
        return True
    if re.match(r'^(?:\([^)]+\)\s*)?[~/\w\.\-]+\s*[\$#%>]\s*$', s):
        return True
    if re.match(r'^[\w\.\-~/$]+[#\$%>]\s*$', s):
        return True
    if re.search(r'^(?:PS\s+)?[a-zA-Z]:\\.*[#\$%>]\s*$', s):
        return True
    return False


def is_option_line(s):
    return bool(re.match(r'^\s*[❯>]?\s*(?:[\[\(]?\d{1,2}[\]\).:]|[\[\(][ xX●•*]?[\]\)])\s+\w+', s))


def detect_prompt(buffer_text):
    """Kembalikan payload prompt jika teks buffer terlihat seperti pertanyaan interaktif aktif di posisi terbawah."""
    lines = clean_terminal_text(buffer_text)
    if not lines:
        return None
    last = lines[-1].strip()
    if not last or len(last) > 400:
        return None

    # Jika baris terakhir adalah shell prompt biasa, perintah sudah selesai; jangan kirim prompt usang
    if is_shell_prompt(last):
        return None

    # Cek baris aktif (apakah baris terakhir adalah kursor saja)
    is_cursor_line = bool(re.match(r'^[❯>#\$%:\?]\s*$', last))
    inspect_line = lines[-2].strip() if (is_cursor_line and len(lines) >= 2) else last

    if is_shell_prompt(inspect_line):
        return None

    # Verifikasi apakah posisi ujung terminal (tail) memang benar-benar menunggu konfirmasi aktif
    is_enter_prompt = bool(re.search(r'(?i)(press|tekan)\s+(\[?enter\]?|return|any key|sembarang)', inspect_line))
    is_yn = bool(re.search(r'[\[\(]\s*y(?:es)?[/\s,]+n(?:o)?', inspect_line, re.IGNORECASE) or re.search(r'[\[\(]\s*y/n\s*[\]\)]', inspect_line, re.IGNORECASE))
    is_statement = (inspect_line.endswith('.') or bool(re.search(r'(?i)\b(denied|passed|failed|completed|success|error)\b', inspect_line)))
    is_kw_permission = bool(('?' in inspect_line or AI_PERMISSION_KW.search(inspect_line)) and not is_statement)
    is_menu_opt = bool(is_option_line(inspect_line))

    if not (is_enter_prompt or is_yn or is_kw_permission or is_menu_opt):
        return None

    context = '\n'.join(l for l in lines[-16:] if l.strip())

    # 1. Menunggu Enter murni (Press Enter to continue, dll.)
    if is_enter_prompt:
        return {
            'app': 'Terminal',
            'title': 'Menunggu Enter',
            'message': context,
            'options': [_opt('Lanjut', 'enter', '\r', key='Enter', primary=True)],
        }

    # 2. Deteksi pertanyaan CLI / AI Agent (kata kunci izin, biner [y/n], atau opsi menu)
    title, message = extract_prompt_details(lines, context, inspect_line)

    # Deteksi apakah menggunakan Bubbletea cursor menu (❯) atau menu biasa
    is_bubbletea = ('❯' in context or any('❯' in l for l in lines[-8:]))

    if is_bubbletea:
        # Pada Bubbletea TUI (seperti agy/charm):
        # Kursor sudah berada di item 1 (Yes). Tekan Enter (\r) untuk memilih.
        # Item 2 (Allow in this chat): Panah Bawah (\x1b[B) + Enter (\r).
        # Item 3 (Allow in this project): Panah Bawah 2x (\x1b[B\x1b[B) + Enter (\r).
        # Item 4 (No / Deny): Escape (\x1b) untuk membatalkan / menolak.
        yes_send = '\r'
        chat_send = '\x1b[B\r'
        project_send = '\x1b[B\x1b[B\r'
        no_send = '\x1b'
    elif is_yn:
        # Prompt CLI biasa [y/N]
        yes_send = 'y\r'
        chat_send = 'y\r'
        project_send = 'y\r'
        no_send = 'n\r'
    else:
        # Menu pilihan berbasis angka
        yes_send = '1\r'
        chat_send = '2\r'
        project_send = '3\r'
        no_send = '4\r'

    return {
        'app': 'Terminal',
        'title': title,
        'message': message,
        'options': [
            _opt('Yes', 'yes', yes_send, key='y', primary=True),
            _opt('Allow in this chat', 'allow_chat', chat_send, key='c', primary=False),
            _opt('Allow in this project', 'allow_project', project_send, key='a', primary=False),
            _opt('No', 'no', no_send, key='n', danger=True)
        ]
    }



class DigiTermSupervisor:
    def __init__(self, command=None):
        self.command = command or [os.environ.get('SHELL', '/bin/bash')]
        self.master_fd = None
        self.pid = None
        self.running = True
        self.buf = ""
        self.buf_lock = threading.Lock()
        self.last_output = time.time()
        self.active_id = None
        self.active_lock = threading.Lock()

    # ── Helpers ──
    def sync_winsize(self, *_):
        if self.master_fd is None:
            return
        try:
            ws = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, struct.pack('HHHH', 0, 0, 0, 0))
            fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, ws)
            if self.pid:
                os.kill(self.pid, signal.SIGWINCH)
        except Exception:
            pass

    def clear_buffer(self):
        with self.buf_lock:
            self.buf = ""

    def dismiss_active(self):
        with self.active_lock:
            pid, self.active_id = self.active_id, None
        if not pid:
            return
        try:
            req = urllib.request.Request(DISMISS_URL, data=json.dumps({'prompt_id': pid}).encode(),
                                         headers={'Content-Type': 'application/json'})
            urllib.request.urlopen(req, timeout=1.5).close()
        except Exception:
            pass

    # ── Watcher ──
    def watcher(self):
        while self.running:
            time.sleep(0.08)
            with self.buf_lock:
                text = self.buf
                idle = time.time() - self.last_output
            if not text:
                continue

            # WAJIB: Tunggu output terminal benar-benar berhenti (settled) minimal 0.28 detik
            # Jangan pernah bypass idle check agar kartu tidak muncul saat perintah masih streaming
            if idle < 0.28:
                continue

            with self.active_lock:
                if self.active_id:
                    if time.time() - getattr(self, 'active_time', 0) > 30:
                        self.active_id = None
                    else:
                        continue

            payload = detect_prompt(text)
            if not payload:
                continue

            prompt_id = f"term_{os.getpid()}_{int(time.time() * 1000)}"
            with self.active_lock:
                self.active_id = prompt_id
                self.active_time = time.time()
            self.clear_buffer()
            threading.Thread(target=self.dispatch, args=(prompt_id, payload), daemon=True).start()

    def dispatch(self, prompt_id, payload):
        send_map = {str(o['value']): o['send'] for o in payload['options']}
        body = dict(payload)
        body['options'] = [{k: v for k, v in o.items() if k != 'send'} for o in payload['options']]
        body.update({'id': prompt_id, 'timeout': PROMPT_TIMEOUT, 'execute_on_pc': False})
        try:
            req = urllib.request.Request(PROMPT_URL, data=json.dumps(body).encode(),
                                         headers={'Content-Type': 'application/json'})
            with urllib.request.urlopen(req, timeout=PROMPT_TIMEOUT + 5) as resp:
                res = json.loads(resp.read().decode()).get('response', {})
        except Exception:
            res = {}
        with self.active_lock:
            if self.active_id != prompt_id:
                return  # dibatalkan karena pengguna mengetik langsung di PC
            self.active_id = None
        if res.get('action') != 'responded' or self.master_fd is None:
            return
        to_send = send_map.get(str(res.get('value')))
        if to_send is None:
            return
        try:
            os.write(self.master_fd, to_send.encode())
        except OSError:
            pass

    # ── Main loop ──
    def run(self):
        self.pid, self.master_fd = pty.fork()
        if self.pid == 0:
            os.environ['DIGI_TERM_SUPERVISED'] = '1'
            os.environ.setdefault('TERM', 'xterm-256color')
            try:
                os.execvp(self.command[0], self.command)
            except Exception as e:
                sys.stderr.write(f"digi-term: gagal menjalankan {self.command[0]}: {e}\n")
                os._exit(127)

        self.sync_winsize()
        signal.signal(signal.SIGWINCH, self.sync_winsize)

        stdin_fd = sys.stdin.fileno()
        old_attr = None
        if os.isatty(stdin_fd):
            old_attr = termios.tcgetattr(stdin_fd)
            tty.setraw(stdin_fd)

        threading.Thread(target=self.watcher, daemon=True).start()
        exit_code = 0
        try:
            while True:
                try:
                    r, _, _ = select.select([stdin_fd, self.master_fd], [], [])
                except InterruptedError:
                    continue
                if stdin_fd in r:
                    data = os.read(stdin_fd, 1024)
                    if not data:
                        break
                    # Abaikan tombol panah navigasi ANSI (Up/Down/Left/Right) agar pengguna dapat melihat menu di PC tanpa menutup kartu di HP
                    is_nav_key = data in (b'\x1b[A', b'\x1b[B', b'\x1b[C', b'\x1b[D', b'\x1bOA', b'\x1bOB', b'\x1bOC', b'\x1bOD')
                    if not is_nav_key:
                        self.dismiss_active()
                        self.clear_buffer()
                    os.write(self.master_fd, data)
                if self.master_fd in r:
                    try:
                        data = os.read(self.master_fd, 4096)
                    except OSError:
                        break
                    if not data:
                        break
                    os.write(sys.stdout.fileno(), data)
                    with self.buf_lock:
                        decoded = data.decode('utf-8', errors='ignore')
                        self.buf = (self.buf + decoded)[-3072:]
                        stripped = strip_ansi(decoded).strip()
                        # Abaikan karakter spinner animasi (braille unicode dan simbol spinner) agar tidak mereset idle timer
                        clean_stripped = "".join(c for c in stripped if c not in r"⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏-\|/◐◓◑◒" and not (0x2800 <= ord(c) <= 0x28FF)).strip()
                        if clean_stripped:
                            self.last_output = time.time()
                            # Jika kartu sedang aktif di HP dan program di terminal sudah mencetak teks baru yang signifikan,
                            # berarti proses telah berjalan atau sudah dijawab di PC. Tutup kartu aktif segera!
                            if self.active_id and (len(clean_stripped) > 3 or '\n' in decoded):
                                self.dismiss_active()
                                self.clear_buffer()
        finally:
            self.running = False
            self.dismiss_active()
            if old_attr:
                termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_attr)
            try:
                _, status = os.waitpid(self.pid, 0)
                exit_code = os.WEXITSTATUS(status) if os.WIFEXITED(status) else 1
            except ChildProcessError:
                pass
        sys.exit(exit_code)


def main():
    if os.environ.get('DIGI_TERM_SUPERVISED') == '1':
        # Sudah di dalam digi-term: jalankan langsung tanpa membungkus dua kali
        if len(sys.argv) > 1:
            os.execvp(sys.argv[1], sys.argv[1:])
        sys.exit(0)
    if '--banner' in sys.argv:
        sys.argv.remove('--banner')
        print("\033[1;36mDigiSmartDeck Smart Terminal aktif.\033[0m "
              "Pertanyaan konfirmasi di terminal ini akan muncul di HP Anda.\n")
    DigiTermSupervisor(sys.argv[1:] or None).run()


if __name__ == '__main__':
    main()
