#!/usr/bin/env python3
"""
DigiSmartDeck Smart Terminal Supervisor (digi-term)

Menjalankan shell/perintah di dalam pseudoterminal (PTY) dan memantau output-nya.
Ketika program di dalam terminal berhenti menunggu jawaban (Y/n, Allow/Deny,
menu bernomor, "Press Enter"), pertanyaan tersebut dikirim ke HP DigiSmartDeck
sebagai kartu pilihan. Jawaban dari HP disuntikkan langsung ke stdin terminal ini
saja -- tidak ada tombol yang dikirim ke jendela lain.

Platform: Linux dan macOS (POSIX PTY). Windows (ConPTY) belum didukung.

Pemakaian:
  digi-term                 # buka shell default di bawah pengawasan
  digi-term npm install     # jalankan satu perintah di bawah pengawasan
"""

import os
import sys

if os.name != 'posix':
    sys.stderr.write("digi-term saat ini hanya mendukung Linux dan macOS.\n")
    sys.exit(1)

import pty
import tty
import select
import termios
import struct
import fcntl
import signal
import json
import re
import time
import threading
import urllib.request

SERVER_PORT = int(os.environ.get('DIGI_PORT', '8080'))
PROMPT_URL = f"http://127.0.0.1:{SERVER_PORT}/api/prompt?wait=true"
DISMISS_URL = f"http://127.0.0.1:{SERVER_PORT}/api/prompt/dismiss"

ANSI_RE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1B\\))')
IDLE_SECONDS = 0.22          # output harus diam selama ini sebelum dianggap menunggu input
PROMPT_TIMEOUT = 120         # detik kartu tetap tampil di HP


def strip_ansi(text):
    return ANSI_RE.sub('', text).replace('\r', '')


def _opt(label, value, send, key=None, primary=False, danger=False):
    o = {'label': label, 'value': value, 'send': send}
    if key:
        o['key'] = key
    if primary:
        o['primary'] = True
    if danger:
        o['danger'] = True
    return o


def clean_terminal_text(buffer_text):
    clean = ANSI_RE.sub('', buffer_text)
    raw_lines = clean.split('\n')
    lines = []
    for l in raw_lines:
        parts = l.split('\r')
        effective = parts[-1].rstrip()
        if effective:
            lines.append(effective)
    return lines


AI_PERMISSION_KW = re.compile(
    r'(?i)\b('
    r'ask(?:ing)? for permission|'
    r'run(?:ning)? (?:this|the following)?\s*command|'
    r'execute(?:ing)? (?:this|the following)?\s*command|'
    r'allow|approve|permit|authori[sz]e|permission|'
    r'izinkan|setujui|berikan izin|'
    r'do you want to (?:run|execute|proceed|continue|install|apply|delete|remove|overwrite)|'
    r'would you like to (?:run|execute|proceed|continue|install|apply)|'
    r'are you sure you want to|apakah anda yakin|'
    r'confirm execution|action required|approval required|'
    r'tool confirmation|surfacing tool confirmation|'
    r'allow tool call|deny tool call|allow calling this tool|'
    r'allow access to|proposed command|allow execution'
    r')\b'
)


def extract_prompt_details(lines, context, inspect_line):
    # Cari baris yang secara spesifik menanyakan izin atau eksekusi perintah di 15 baris terakhir
    title = None
    question_line = ""

    for l in reversed(lines[-15:]):
        s = l.strip()
        if not s or re.match(r'^[❯>#\$%:\?\[\]\(\)]+$', s):
            continue
        if AI_PERMISSION_KW.search(s) or '?' in s:
            question_line = s
            break

    if question_line:
        q_lower = question_line.lower()
        if "run" in q_lower and ("command" in q_lower or "this" in q_lower or "following" in q_lower):
            title = "Run This Command?"
        elif "execute" in q_lower and ("command" in q_lower or "this" in q_lower or "following" in q_lower):
            title = "Execute This Command?"
        elif "tool call" in q_lower or "calling this tool" in q_lower:
            title = "Allow Tool Call?"
        elif "ask" in q_lower and "permission" in q_lower:
            title = "Ask for Permission"
        elif "allow" in q_lower or "approve" in q_lower or "permit" in q_lower or "authori" in q_lower:
            title = "Allow This Action?"
        elif "are you sure" in q_lower:
            title = "Are You Sure?"
        elif len(question_line) <= 45 and ('?' in question_line or ':' in question_line):
            title = question_line.rstrip(':?').strip() + '?'

    if not title:
        c_lower = context.lower()
        if "tool call" in c_lower or "tool confirmation" in c_lower:
            title = "Allow Tool Call?"
        elif "run" in c_lower and "command" in c_lower:
            title = "Run This Command?"
        elif "permission" in c_lower:
            title = "Ask for Permission"
        elif "allow" in c_lower or "approve" in c_lower:
            title = "Allow Action?"
        else:
            title = "Izin Tindakan CLI"

    # Context message: ambil baris relevan tanpa kursor kosong
    msg_lines = []
    for l in lines[-12:]:
        s = l.strip()
        if s and not re.match(r'^[❯>#\$%:\?]\s*$', s):
            msg_lines.append(s)

    message = '\n'.join(msg_lines) if msg_lines else context
    return title, message


def detect_prompt(buffer_text):
    """Kembalikan payload prompt jika teks buffer terlihat seperti pertanyaan interaktif."""
    lines = clean_terminal_text(buffer_text)
    if not lines:
        return None
    last = lines[-1].strip()
    if not last or len(last) > 400:
        return None

    # Jika baris terakhir hanya prompt kursor atau petunjuk navigasi
    inspect_line = last
    if (re.match(r'^[❯>#\$%:\?]\s*$', last) or 'to navigate' in last.lower() or 'running' in last.lower()) and len(lines) >= 2:
        inspect_line = lines[-2].strip()

    # Abaikan shell prompt biasa tanpa konteks pertanyaan
    if re.search(r'[\$#%>]\s*$', inspect_line) and not re.search(r'[\?:\[\(]', inspect_line):
        return None

    context = '\n'.join(l for l in lines[-16:] if l.strip())

    # 1. Menunggu Enter murni (Press Enter to continue, dll.)
    if re.search(r'(?i)(press|tekan)\s+(\[?enter\]?|return|any key|sembarang)', context):
        return {
            'app': 'Terminal',
            'title': 'Menunggu Enter',
            'message': context,
            'options': [_opt('Lanjut', 'enter', '\n', key='Enter', primary=True)],
        }

    # 2. Deteksi pertanyaan CLI / AI Agent (kata kunci izin, biner [y/n], atau tanda tanya)
    has_question = any(('?' in l.strip() or AI_PERMISSION_KW.search(l)) for l in lines[-15:])
    is_yn = bool(re.search(r'[\[\(]\s*y(?:es)?[/\s,]+n(?:o)?', context, re.IGNORECASE))
    is_permission = bool(AI_PERMISSION_KW.search(context))

    if has_question or is_permission or is_yn:
        title, message = extract_prompt_details(lines, context, inspect_line)

        # Cek jika CLI menyediakan menu bernomor atau Bubbletea list
        items = []
        for l in lines[-16:]:
            mm = re.match(r'^\s*[❯>]?\s*(?:[\[\(]?(\d{1,2})[\]\).:]\s+|[\[\(][ xX●•*]?[\]\)]\s+)?(.{1,70})$', l)
            if mm:
                text = mm.group(2).strip().lower()
                if '?' not in text and not text.endswith(':') and any(k in text for k in ['yes', 'ya', 'allow', 'izinkan', 'chat', 'session', 'project', 'always', 'selalu', 'no', 'tidak', 'deny', 'tolak', 'cancel', 'batal', 'proceed', 'continue']):
                    num = mm.group(1) or str(len(items) + 1)
                    items.append((num, text))

        yes_send = '1\n' if any(num == '1' for num, _ in items) else 'y\n'
        chat_send = '2\n' if any(num == '2' for num, _ in items) else 'c\n'
        project_send = '3\n' if any(num == '3' for num, _ in items) else 'a\n'
        no_send = '4\n' if any(num == '4' for num, _ in items) else ('3\n' if any(num == '3' and 'no' in t for num, t in items) else 'n\n')

        yes_key = '1' if any(num == '1' for num, _ in items) else 'y'
        chat_key = '2' if any(num == '2' for num, _ in items) else 'c'
        project_key = '3' if any(num == '3' for num, _ in items) else 'a'
        no_key = '4' if any(num == '4' for num, _ in items) else 'n'

        if items:
            for num, text in items:
                if any(k in text for k in ['chat', 'session', 'conversation']):
                    chat_send = f'{num}\n'
                    chat_key = num
                elif any(k in text for k in ['project', 'always', 'selalu', "don't ask"]):
                    project_send = f'{num}\n'
                    project_key = num
                elif any(k in text for k in ['yes', 'ya', 'allow once', 'run this time']):
                    yes_send = f'{num}\n'
                    yes_key = num
                elif any(k in text for k in ['no', 'tidak', 'deny', 'tolak', 'cancel', 'batal', 'abort']):
                    no_send = f'{num}\n'
                    no_key = num

        return {
            'app': 'Terminal',
            'title': title,
            'message': message,
            'options': [
                _opt('Yes', 'yes', yes_send, key=yes_key, primary=True),
                _opt('Allow in this chat', 'allow_chat', chat_send, key=chat_key, primary=False),
                _opt('Allow in this project', 'allow_project', project_send, key=project_key, primary=False),
                _opt('No', 'no', no_send, key=no_key, danger=True)
            ]
        }

    return None



class DigiTermSupervisor:
    def __init__(self, command=None):
        self.command = command or [os.environ.get('SHELL', '/bin/bash')]
        self.master_fd = None
        self.pid = None
        self.running = True
        self.buf = ""
        self.buf_lock = threading.Lock()
        self.last_output = time.time()
        self.active_id = None
        self.active_lock = threading.Lock()

    # ── Helpers ──
    def sync_winsize(self, *_):
        if self.master_fd is None:
            return
        try:
            ws = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, struct.pack('HHHH', 0, 0, 0, 0))
            fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, ws)
            if self.pid:
                os.kill(self.pid, signal.SIGWINCH)
        except Exception:
            pass

    def clear_buffer(self):
        with self.buf_lock:
            self.buf = ""

    def dismiss_active(self):
        with self.active_lock:
            pid, self.active_id = self.active_id, None
        if not pid:
            return
        try:
            req = urllib.request.Request(DISMISS_URL, data=json.dumps({'prompt_id': pid}).encode(),
                                         headers={'Content-Type': 'application/json'})
            urllib.request.urlopen(req, timeout=1.5).close()
        except Exception:
            pass

    # ── Watcher ──
    def watcher(self):
        while self.running:
            time.sleep(0.08)
            with self.buf_lock:
                text = self.buf
                idle = time.time() - self.last_output
            if not text:
                continue
            with self.active_lock:
                if self.active_id:
                    if time.time() - getattr(self, 'active_time', 0) > 30:
                        self.active_id = None
                    else:
                        continue
            payload = detect_prompt(text)
            if not payload:
                continue

            # Jika prompt penting (izin aksi/perintah AI), langsung kirim tanpa menunggu idle timer
            is_priority = any(k in payload.get('title', '').lower() for k in ['allow', 'run', 'permission', 'izin', 'eksekusi', 'konfirmasi', 'sure'])
            if not is_priority and idle < IDLE_SECONDS:
                continue

            prompt_id = f"term_{os.getpid()}_{int(time.time() * 1000)}"
            with self.active_lock:
                self.active_id = prompt_id
                self.active_time = time.time()
            # Prompt ini sudah diproses; jangan dikirim ulang dari buffer yang sama
            self.clear_buffer()
            threading.Thread(target=self.dispatch, args=(prompt_id, payload), daemon=True).start()

    def dispatch(self, prompt_id, payload):
        send_map = {str(o['value']): o['send'] for o in payload['options']}
        body = dict(payload)
        body['options'] = [{k: v for k, v in o.items() if k != 'send'} for o in payload['options']]
        body.update({'id': prompt_id, 'timeout': PROMPT_TIMEOUT, 'execute_on_pc': False})
        try:
            req = urllib.request.Request(PROMPT_URL, data=json.dumps(body).encode(),
                                         headers={'Content-Type': 'application/json'})
            with urllib.request.urlopen(req, timeout=PROMPT_TIMEOUT + 5) as resp:
                res = json.loads(resp.read().decode()).get('response', {})
        except Exception:
            res = {}
        with self.active_lock:
            if self.active_id != prompt_id:
                return  # dibatalkan karena pengguna mengetik langsung di PC
            self.active_id = None
        if res.get('action') != 'responded' or self.master_fd is None:
            return
        to_send = send_map.get(str(res.get('value')))
        if to_send is None:
            return
        try:
            os.write(self.master_fd, to_send.encode())
        except OSError:
            pass

    # ── Main loop ──
    def run(self):
        self.pid, self.master_fd = pty.fork()
        if self.pid == 0:
            os.environ['DIGI_TERM_SUPERVISED'] = '1'
            os.environ.setdefault('TERM', 'xterm-256color')
            try:
                os.execvp(self.command[0], self.command)
            except Exception as e:
                sys.stderr.write(f"digi-term: gagal menjalankan {self.command[0]}: {e}\n")
                os._exit(127)

        self.sync_winsize()
        signal.signal(signal.SIGWINCH, self.sync_winsize)

        stdin_fd = sys.stdin.fileno()
        old_attr = None
        if os.isatty(stdin_fd):
            old_attr = termios.tcgetattr(stdin_fd)
            tty.setraw(stdin_fd)

        threading.Thread(target=self.watcher, daemon=True).start()
        exit_code = 0
        try:
            while True:
                try:
                    r, _, _ = select.select([stdin_fd, self.master_fd], [], [])
                except InterruptedError:
                    continue
                if stdin_fd in r:
                    data = os.read(stdin_fd, 1024)
                    if not data:
                        break
                    # Abaikan tombol panah navigasi ANSI (Up/Down/Left/Right) agar pengguna dapat melihat menu di PC tanpa menutup kartu di HP
                    is_nav_key = data in (b'\x1b[A', b'\x1b[B', b'\x1b[C', b'\x1b[D', b'\x1bOA', b'\x1bOB', b'\x1bOC', b'\x1bOD')
                    if not is_nav_key:
                        self.dismiss_active()
                        self.clear_buffer()
                    os.write(self.master_fd, data)
                if self.master_fd in r:
                    try:
                        data = os.read(self.master_fd, 4096)
                    except OSError:
                        break
                    if not data:
                        break
                    os.write(sys.stdout.fileno(), data)
                    with self.buf_lock:
                        decoded = data.decode('utf-8', errors='ignore')
                        self.buf = (self.buf + decoded)[-3072:]
                        stripped = strip_ansi(decoded).strip()
                        # Abaikan karakter spinner animasi (braille unicode dan simbol spinner) agar tidak mereset idle timer
                        clean_stripped = "".join(c for c in stripped if c not in r"⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏-\|/◐◓◑◒" and not (0x2800 <= ord(c) <= 0x28FF)).strip()
                        if clean_stripped:
                            self.last_output = time.time()
        finally:
            self.running = False
            self.dismiss_active()
            if old_attr:
                termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_attr)
            try:
                _, status = os.waitpid(self.pid, 0)
                exit_code = os.WEXITSTATUS(status) if os.WIFEXITED(status) else 1
            except ChildProcessError:
                pass
        sys.exit(exit_code)


def main():
    if os.environ.get('DIGI_TERM_SUPERVISED') == '1':
        # Sudah di dalam digi-term: jalankan langsung tanpa membungkus dua kali
        if len(sys.argv) > 1:
            os.execvp(sys.argv[1], sys.argv[1:])
        sys.exit(0)
    if '--banner' in sys.argv:
        sys.argv.remove('--banner')
        print("\033[1;36mDigiSmartDeck Smart Terminal aktif.\033[0m "
              "Pertanyaan konfirmasi di terminal ini akan muncul di HP Anda.\n")
    DigiTermSupervisor(sys.argv[1:] or None).run()


if __name__ == '__main__':
    main()
